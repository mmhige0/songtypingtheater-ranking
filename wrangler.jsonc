{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "songtypingtheater-ranking",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  // favicon等の静的ファイル。該当しないパスはWorkerが処理する
  "assets": { "directory": "./public" },
  // 独自ドメインだけで受け付ける
  "workers_dev": false,
  "routes": [
    { "pattern": "ranking.kayomodoki.com", "custom_domain": true },
    { "pattern": "kayomodoki.com", "custom_domain": true }
  ],
  // TOP_ORIGINのホストでは`/`にトップを出し、それ以外のパスはRANKING_ORIGINへ転送する。
  // RANKING_ORIGIN（とlocalhost等それ以外のホスト）の`/`は曲一覧へ転送する。両者が同じなら1つのホストで両方出す（src/lib/site-host.ts）
  "vars": {
    "TOP_ORIGIN": "https://kayomodoki.com",
    "RANKING_ORIGIN": "https://ranking.kayomodoki.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "songtypingtheater-ranking",
      "database_id": "4a20ec6b-c885-42f8-a301-bab943e8d917",
      "migrations_dir": "migrations"
    }
  ],
  // 送信回数制限（データセンター単位の近似値）。periodは10または60秒のみ指定可能
  "ratelimits": [
    { "name": "PLAYS_IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "PLAYS_PLAYER_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    { "name": "INSTALLATIONS_IP_LIMITER", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } },
    // 閲覧API・画面（送信APIと別枠）
    { "name": "VIEW_IP_LIMITER", "namespace_id": "1004", "simple": { "limit": 120, "period": 60 } }
  ]
}
