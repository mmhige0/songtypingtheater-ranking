{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "songtypingtheater-ranking",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "songtypingtheater-ranking",
      // `wrangler d1 create songtypingtheater-ranking` で発行されたIDに置き換える
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
