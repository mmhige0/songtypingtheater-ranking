{
  "name": "songtypingtheater-ranking",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types --strict-vars=false",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "lint": "eslint .",
    "typecheck": "wrangler types --strict-vars=false && tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "node --test scripts/check-song-navigation.mjs && vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "register-songs": "tsx scripts/register-songs.ts",
    "migrate-legacy-scores": "tsx scripts/migrate-legacy-scores.ts",
    "rebuild-song-best": "tsx scripts/rebuild-song-best.ts",
    "link-legacy-players": "tsx scripts/link-legacy-players.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.10",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "csv-parse": "^7.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "exceljs": "^4.4.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  }
}
