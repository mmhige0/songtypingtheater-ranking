{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "songtypingtheater-ranking-preview",
  "main": "src/preview.ts",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public"
  },
  "workers_dev": true,
  "routes": [],
  "vars": {
    "TOP_ORIGIN": "https://preview.invalid",
    "RANKING_ORIGIN": "https://preview.invalid"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "songtypingtheater-ranking",
      "database_id": "4a20ec6b-c885-42f8-a301-bab943e8d917",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "PLAYS_IP_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "PLAYS_PLAYER_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "INSTALLATIONS_IP_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "VIEW_IP_LIMITER",
      "namespace_id": "1004",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "preview_urls": false
}
